#!/usr/bin/env bash
# Pre-push audit for the public shared-goals/skill repo.
# Blocks a push whose outgoing commits ADD local specifics.
# Generic patterns only. Real private names, if ever needed, belong in
# gitignored .githooks/local-patterns.txt (one ERE per line) — never here.
# Escape hatch (review first!): PRE_PUSH_AUDIT_SKIP=1 git push
set -u

if [ "${PRE_PUSH_AUDIT_SKIP:-0}" = "1" ]; then
  echo "pre-push audit: SKIPPED by PRE_PUSH_AUDIT_SKIP" >&2
  exit 0
fi

PATTERNS=(
  '/mnt/[A-Za-z]'
  '/Users/[A-Za-z]'
  '[a-zA-Z0-9-]+\.lan\b'
  'localhost:[0-9]{2,5}\b'
  '\b(192\.168|10\.[0-9]{1,3})\.[0-9]{1,3}\.[0-9]{1,3}\b'
  'AKIA[0-9A-Z]{16}'
  'ghp_[0-9A-Za-z]{20,}'
  'sk-ant-[0-9A-Za-z-]{20,}'
  'sk-[0-9A-Za-z]{20,}'
)
EXTRA='.githooks/local-patterns.txt'
if [ -f "$EXTRA" ]; then
  while IFS= read -r p; do
    case "$p" in ''|'#'*) continue ;; esac
    PATTERNS+=("$p")
  done < "$EXTRA"
fi
re=$(IFS='|'; echo "${PATTERNS[*]}")

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue   # deletion
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # new ref: audit full content of every tracked file
    files=$(git ls-tree -r --name-only "$local_sha")
    added() { git show "$local_sha:$f" 2>/dev/null; }
  else
    range="$remote_sha..$local_sha"
    files=$(git diff --name-only "$range")
    added() { git diff -U0 "$range" -- "$f" | grep '^+' | grep -v '^+++' | sed 's/^+//'; }
  fi
  for f in $files; do
    hits=$(added | grep -nE "$re")
    if [ -n "$hits" ]; then
      fail=1
      echo "PUSH BLOCKED by .githooks/pre-push — local specifics in $f:" >&2
      echo "$hits" | sed 's/^/  /' >&2
      echo "(generalize the hit, move it to gitignored references/, or review" >&2
      echo " and override with: PRE_PUSH_AUDIT_SKIP=1 git push)" >&2
    fi
  done
done

exit "$fail"
